  </component>

  <component>
    <type>org.exoplatform.web.security.codec.CodecInitializer</type>
    <init-params>
      <value-param>
        <name>gatein.conf.dir</name>
        <value>jar:/conf</value>
      </value-param>
    </init-params>
  </component>

  <component>
    <key>org.exoplatform.web.application.javascript.JavascriptConfigService</key>
