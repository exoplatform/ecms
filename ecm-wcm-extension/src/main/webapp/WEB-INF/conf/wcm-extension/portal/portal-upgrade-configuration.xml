              <string>war:/conf/sites/</string>
            </field>
            <field name="portalType">
              <string>portal</string>
            </field>
            <field name="portalName">
              <string>administration</string>
            </field>
            <field name="deleteNavigations">
              <collection type="java.util.ArrayList" item-type="java.lang.String">
                <value>
                  <string>home/applications/documents-settings/cloud-storage</string>
                </value>
                <value>
                  <string>home/applications/documents-settings/documents-editors</string>
                </value>
                <value>
                  <string>home/legacy</string>
                </value>
              </collection>
            </field>
